# --- Core ---
ANTHROPIC_API_KEY=
PORT=3001
# Public URL of this server; used to build the review links in emails.
PUBLIC_BASE_URL=https://agents.example.com
# Long random string. Signs the review links so only the recipient can act on them.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LINK_SIGNING_SECRET=
# How long a review link stays valid.
LINK_TTL_DAYS=14
# Protects the /admin endpoints (send as the x-admin-key header).
ADMIN_API_KEY=
# Set to false to disable the weekly schedule (e.g. on a dev machine).
ENABLE_SCHEDULER=true
DATA_DIR=data

# --- Email (SMTP). Leave SMTP_HOST empty to write emails to data/outbox/ instead of sending. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="GreenTree Content Agent <content@example.com>"

# --- GreenTree agent ---
GREENTREE_APPROVER_EMAIL=
GREENTREE_REVIEWER_EMAIL=
GREENTREE_LICENSE_LINE="Kevin Hood | Green Tree Properties | DRE #00000000"
GREENTREE_VALUATION_URL=https://greentreeproperties.com/home-valuation
GREENTREE_CALENDLY_URL=https://calendly.com/kevinhood/consultation
# Where approved posts go. Point each at a Zapier/Make/Buffer webhook; leave empty for dry-run (logged only).
GREENTREE_WEBHOOK_INSTAGRAM=
GREENTREE_WEBHOOK_FACEBOOK=
GREENTREE_WEBHOOK_LINKEDIN=
GREENTREE_WEBHOOK_NEWSLETTER=
